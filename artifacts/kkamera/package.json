    "expo-file-system": "~57.0.7",
    "expo-local-authentication": "~57.0.3",
    "expo-media-library": "~57.0.5",
    "expo-network": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-sensors": "~57.0.3",
    "expo-sharing": "~57.0.22",
    "expo-speech": "~57.0.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "0.86.3",
    "react-native-document-scanner-plugin": "2.0.4",
    "react-native-purchases": "10.9.1",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.2",
    "serve": "^14.2.4"
  }
