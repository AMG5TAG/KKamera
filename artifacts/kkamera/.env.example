# Copy to .env.local (git-ignored) for local development on your Mac.
# Expo loads it automatically; restart `pnpm start` after changing it.

# API server the app talks to. Leave unset to use production
# (https://app.kkamera.app), or point it at the Replit dev server or a local
# API. A phone or emulator can't reach your Mac's "localhost", so use the
# Mac's LAN IP (Android emulator: http://10.0.2.2:8080).
# EXPO_PUBLIC_API_URL=https://<your-repl>.replit.dev:8080
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8080

# RevenueCat public SDK keys (same values as in .replit [userenv.shared]).
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
