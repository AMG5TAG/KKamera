{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_REVENUECAT_TEST_API_KEY": "test_EeMOwLvsDSdIXMlgAwslVdkDIIQ"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_REVENUECAT_IOS_API_KEY": "appl_TFHVoaPvLiXpMTMLlCqVyhmTBfW",
        "EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY": "goog_yaGBOKjGHSXhTULboFWQCyfsJnM"
      }
    },
    "alpha": {
      "extends": "production",
      "environment": "preview",
      "channel": "alpha"
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_REVENUECAT_IOS_API_KEY": "appl_TFHVoaPvLiXpMTMLlCqVyhmTBfW",
        "EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY": "goog_yaGBOKjGHSXhTULboFWQCyfsJnM"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "admin@koastal.com.au",
        "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APP_ID",
        "appleTeamId": "REPLACE_WITH_APPLE_TEAM_ID"
      },
      "android": {
        "serviceAccountKeyPath": "./play-service-account.json",
        "track": "internal"
      }
    },
    "alpha": {
      "extends": "production"
    }
  }
}
