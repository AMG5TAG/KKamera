{
  "expo": {
    "name": "KKamera",
    "slug": "kkamera",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kkamera",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.kkamera",
      "infoPlist": {
        "NSFaceIDUsageDescription": "KKamera uses Face ID to unlock the app and protect your cloud connections."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.kkamera",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#b19870"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#0d0b08"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "KKamera uses the camera to capture photos and videos for direct cloud upload.",
          "microphonePermission": "KKamera uses the microphone to record audio with your videos.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "When 'Embed GPS in Photos' is on, KKamera adds your GPS position to the photos and videos you capture.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "KKamera uses the camera to capture photos and videos for direct cloud upload."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "KKamera only adds the photos and videos you capture to your library when 'Save to Photos' is on. It does not read your existing photos.",
          "savePhotosPermission": "When 'Save to Photos' is on, KKamera adds the photos and videos you capture to your photo library.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo",
            "video"
          ]
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "KKamera uses motion sensors for the level guide and panorama capture."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "./plugins/withPodsDeploymentTarget",
      "@sentry/react-native",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "8f9afb54-3ba8-4641-a2e1-c23166b759fb"
      }
    },
    "owner": "koasoft",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8f9afb54-3ba8-4641-a2e1-c23166b759fb",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
