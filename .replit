modules = ["nodejs-24", "python-3.11"]

[deployment]
router = "application"
deploymentTarget = "autoscale"
# Build the workspace libs and bundle the API server (esbuild -> dist/index.mjs).
# The API server is JSON-only; the iOS/Android apps are built and shipped via EAS.
build = ["sh", "-c", "pnpm run typecheck:libs && pnpm --filter @workspace/api-server run build"]
# Start the API server.
run = ["sh", "-c", "pnpm --filter @workspace/api-server run start"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["revenuecat:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3003

[[ports]]
localPort = 8090
externalPort = 3001

[[ports]]
localPort = 8091
externalPort = 3002

[[ports]]
localPort = 24623
externalPort = 3000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
